/PROG  MOVEHOME
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "HOME DIRECT";
PROG_SIZE	= 256;
CREATE		= DATE 24-04-16  TIME 07:45:38;
MODIFIED	= DATE 25-07-17  TIME 15:42:58;
FILE_NAME	= HOMEDIR;
VERSION		= 0;
LINE_COUNT	= 2;
MEMORY_SIZE	= 628;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,1,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
  SPOT : TRUE ; 
  SPOT Welding Equipment Number : 1 ;
/MN
   1:J PR[1:HOME] 100% FINE    ;
   2:  CALL IO_RESET    ;
/POS
/END
